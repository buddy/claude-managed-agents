# ---------------------------------------------------------------------------
# Claude Managed Agents (self-hosted) on Buddy Sandboxes — environment template
# Copy to `.env` and fill in. Leave generated values EMPTY — `npm run bootstrap`
# fills ANTHROPIC_ENVIRONMENT_ID / ANTHROPIC_AGENT_ID / BUDDY_BASE_SNAPSHOT_ID
# for you. The format of each value is in its comment.
# ---------------------------------------------------------------------------

# --- Fill these in yourself (before the first run) ---
# Admin API key, LOCAL ONLY (sk-ant-api03-...). Never deployed to a worker.
export ANTHROPIC_API_KEY=
export BUDDY_TOKEN=
export BUDDY_WORKSPACE=
export BUDDY_PROJECT=
# US | EU | AS  (leave empty so the first bootstrap prompts for it; defaults to US)
export BUDDY_REGION=

# --- Filled by `npm run bootstrap` / pasted from the Console (leave empty now) ---
# scripts/create-environment.ts  →  env_...
export ANTHROPIC_ENVIRONMENT_ID=
# Console > Managed Agents > Environments > Generate environment key  →  sk-ant-oat01-...
export ANTHROPIC_ENVIRONMENT_KEY=
# scripts/create-agent.ts  →  agent_...
export ANTHROPIC_AGENT_ID=
# scripts/build-snapshot.ts  →  Buddy snapshot id
export BUDDY_BASE_SNAPSHOT_ID=
# Console webhook signing secret  →  whsec_...  (webhook mode only; leave empty for polling)
export ANTHROPIC_WEBHOOK_SIGNING_KEY=

# --- Trigger mode ---
# How the orchestrator learns there is queued work:
#   webhook (default) — Anthropic POSTs session.status_run_started to the
#       orchestrator's public endpoint; needs ANTHROPIC_WEBHOOK_SIGNING_KEY.
#   polling           — the orchestrator long-polls the work queue itself; no
#       inbound endpoint and no webhook secret required.
# Pick polling to avoid exposing an endpoint / managing a secret; pick webhook
# for lower per-event latency.
export TRIGGER_MODE=webhook

# --- Optional / defaults ---
export ANTHROPIC_AGENT_MODEL=claude-opus-4-8
export ANTHROPIC_BETA=managed-agents-2026-04-01
export ANTHROPIC_BASE_URL=
# Tunnel/endpoint region for the orchestrator's public webhook URL: US | EU | AS
export BUDDY_TUNNEL_REGION=US

# --- Worker runtime tuning ---
# `ant` CLI release baked into the base snapshot.
export ANT_VERSION=1.23.0
# `ant beta:worker run --max-idle` — primary stop signal once the session goes idle.
export ANT_MAX_IDLE=60s
# Buddy resources for worker sandboxes: 1x2 | 2x4 | 3x6 | 4x8 | ... | 12x24
export WORKER_RESOURCES=2x4
# Buddy per-worker idle auto-stop (seconds). Must exceed expected idle gaps.
export WORKER_IDLE_TIMEOUT_SEC=900
# Working directory inside the worker; `ant --workdir` and tools operate here.
export WORKSPACE_DIR=/workspace

# --- Orchestrator ---
export ORCH_PORT=8080
export ORCHESTRATOR_RESOURCES=1x2
export DISPATCHER_DEBOUNCE_MS=250
export DISPATCHER_POLL_BLOCK_MS=999
export DISPATCHER_RECLAIM_MS=30000
export RUN_START_ATTEMPTS=10

# --- Janitor / polling safety net ---
export JANITOR_SECONDS=60
# Destroy STOPPED cma-worker sandboxes older than this many days. 0 disables deletion.
export MAX_IDLE_DAYS=7
# In webhook mode, set false to disable the orchestrator's safety-net polling
# loop. Ignored in polling mode, where the poll loop is the primary trigger and
# always runs.
export POLLER_ENABLED=true
